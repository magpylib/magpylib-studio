{
  // "npm: compile" is what the launch config waits for, so F5 never starts a
  // host on stale JavaScript. It runs tsc *and* the webview script check, so
  // a panel that cannot parse fails here rather than showing up blank.
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile",
      "path": "vscode-extension",
      "group": "build",
      "problemMatcher": ["$tsc"],
      "label": "npm: compile",
      "detail": "tsc -p ./ && node harness/check-webview-scripts.js"
    },
    {
      // Empties the profile "Run Extension (fresh)" opens in; see the script.
      "label": "fresh host profile",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/vscode-extension/harness/fresh-host.js",
        "${userHome}/.cache/magpylib-studio/fresh-host"
      ],
      "problemMatcher": []
    },
    {
      // Empties the machine "Run Extension (fresh machine, no Python)" opens in.
      "label": "fresh machine",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/vscode-extension/harness/fresh-host.js",
        "${userHome}/.cache/magpylib-studio/fresh-machine"
      ],
      "problemMatcher": []
    },
    {
      "label": "npm: compile, fresh machine",
      "dependsOn": ["npm: compile", "fresh machine"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "npm: compile, fresh host profile",
      "dependsOn": ["npm: compile", "fresh host profile"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "watch",
      "path": "vscode-extension",
      "group": "build",
      "isBackground": true,
      "problemMatcher": ["$tsc-watch"],
      "label": "npm: watch"
    }
  ]
}
