# Copied from the repo root at package time (npm run license) so the VSIX
# carries it. Not tracked: one licence file, no second copy to drift.
vscode-extension/LICENSE

.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
*.pyc
magpylib_studio/_version.py
# The widget bundle's intermediate; the product itself is committed.
build/
# marimo's per-notebook session cache, written beside the notebook it ran.
__marimo__/


# sandbox/ is the Extension Development Host's workspace (see its README). Its
# fixtures are tracked; whatever is saved there while trying things is not.
sandbox/*
!sandbox/README.md
!sandbox/.vscode/
!sandbox/env_probe.py
!sandbox/view_from_script.py

.ipynb_checkpoints/

# The agent evaluation's Python environments, and each run's folders and
# transcripts; a run's summary.md and summary.json are kept.
evals/.envs/
evals/results/*/runs/
