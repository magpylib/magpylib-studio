{
  "name": "magpylib-studio-vscode",
  "displayName": "Magpylib Studio",
  "description": "Build and explore magpylib magnet designs: a 3D editor with variables, patterns and field plots.",
  "version": "0.8.0",
  "publisher": "magpylib",
  "license": "BSD-3-Clause",
  "icon": "media/icon.png",
  "preview": true,
  "keywords": [
    "magpylib",
    "magnetics",
    "magnetic field",
    "simulation",
    "physics"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/magpylib/magpylib-studio.git"
  },
  "bugs": {
    "url": "https://github.com/magpylib/magpylib-studio/issues"
  },
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Visualization"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The engine runs as a Python interpreter found in the workspace, and the script tab executes the scene as Python."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "The engine is a local process that reads and writes real files."
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "magpylibStudio.scene",
        "displayName": "Magpylib Studio",
        "selector": [
          {
            "filenamePattern": "*.magpy.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "magpylib-studio.toggleDrawScriptsHere",
        "title": "Draw Scripts in a Panel",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.openStudio",
        "title": "Open Scene View",
        "icon": "$(open-preview)",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.showScene",
        "title": "Show Scene",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.restartEngine",
        "title": "Restart Engine",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.refreshScene",
        "title": "Refresh Scene",
        "icon": "$(refresh)",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.selectObject",
        "title": "Select Object in Studio",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.loadExample",
        "title": "Load Example Scene...",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.openFieldView",
        "title": "Open Field View",
        "icon": "$(graph-line)",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.viewScript",
        "title": "Edit Python Script",
        "icon": "$(code)",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.saveScene",
        "title": "Save Scene",
        "icon": "$(save)",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.saveSceneAs",
        "title": "Save Scene As...",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.loadScene",
        "title": "Open Scene...",
        "category": "Magpylib Studio",
        "icon": "$(folder-opened)"
      },
      {
        "command": "magpylib-studio.newScene",
        "title": "New Scene",
        "category": "Magpylib Studio",
        "icon": "$(new-file)"
      },
      {
        "command": "magpylib-studio.closeScene",
        "title": "Close Scene",
        "icon": "$(close)",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.closeAllScenes",
        "title": "Close All Scenes",
        "category": "Magpylib Studio",
        "icon": "$(close-all)"
      },
      {
        "command": "magpylib-studio.revealSceneInExplorer",
        "title": "Reveal in Explorer View",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.revealSceneInOS",
        "title": "Reveal in Finder",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.revealSceneInFileManager",
        "title": "Open Containing Folder",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.copyScenePath",
        "title": "Copy Path",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.revertScene",
        "title": "Revert Scene to Saved",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.exportScript",
        "title": "Export as Python Script...",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.exportBuilderScript",
        "title": "Export as Scene Script...",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.importScript",
        "title": "Import Python Script...",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.openScriptInStudio",
        "title": "Open in Magpylib Studio"
      },
      {
        "command": "magpylib-studio.switchScene",
        "title": "Switch Imported Scene...",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.undo",
        "title": "Undo Scene Edit",
        "icon": "$(discard)",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.redo",
        "title": "Redo Scene Edit",
        "icon": "$(redo)",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.undoTyping",
        "title": "Undo Typing",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.redoTyping",
        "title": "Redo Typing",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.removeObject",
        "title": "Remove Object"
      },
      {
        "command": "magpylib-studio.resetStyle",
        "title": "Reset Style"
      },
      {
        "command": "magpylib-studio.moveTo",
        "title": "Move to..."
      },
      {
        "command": "magpylib-studio.gotoHistory",
        "title": "Jump to Undo Step",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.newCollection",
        "title": "New Collection...",
        "icon": "$(new-folder)"
      },
      {
        "command": "magpylib-studio.addObject",
        "title": "Add Object...",
        "icon": "$(add)",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.addMesh",
        "title": "Add Triangular Mesh...",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.importMesh",
        "title": "Import Mesh...",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.meshFromPoints",
        "title": "Mesh from Points...",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.meshFromFormula",
        "title": "Mesh from a Formula...",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.setPosition",
        "title": "Set Position..."
      },
      {
        "command": "magpylib-studio.moveBy",
        "title": "Move By...",
        "icon": "$(move)"
      },
      {
        "command": "magpylib-studio.rotateBy",
        "title": "Rotate...",
        "icon": "$(sync)"
      },
      {
        "command": "magpylib-studio.clearPath",
        "title": "Clear Path"
      },
      {
        "command": "magpylib-studio.pixelGrid",
        "title": "Pixel Grid..."
      },
      {
        "command": "magpylib-studio.toggleVisibility",
        "title": "Toggle Visibility",
        "icon": "$(eye)"
      },
      {
        "command": "magpylib-studio.copyObject",
        "title": "Copy"
      },
      {
        "command": "magpylib-studio.cutObject",
        "title": "Cut"
      },
      {
        "command": "magpylib-studio.pasteObject",
        "title": "Paste"
      },
      {
        "command": "magpylib-studio.renameObject",
        "title": "Rename..."
      },
      {
        "command": "magpylib-studio.addVariable",
        "title": "New Variable...",
        "icon": "$(add)"
      },
      {
        "command": "magpylib-studio.editVariable",
        "title": "Edit Variable..."
      },
      {
        "command": "magpylib-studio.renameVariable",
        "title": "Rename Variable..."
      },
      {
        "command": "magpylib-studio.removeVariable",
        "title": "Remove Variable",
        "icon": "$(trash)"
      },
      {
        "command": "magpylib-studio.duplicateAround",
        "title": "Pattern..."
      },
      {
        "command": "magpylib-studio.sweep",
        "title": "Sweep a Variable...",
        "icon": "$(graph-line)",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.saveVariant",
        "title": "Save as Variant...",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.saveOverVariant",
        "title": "Save Over the Variant in Use",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.renameVariant",
        "title": "Rename Variant...",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.removeVariant",
        "title": "Delete Variant...",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.setVariableBounds",
        "title": "Variable Properties..."
      },
      {
        "command": "magpylib-studio.setUnits",
        "title": "Units...",
        "icon": "$(symbol-ruler)",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.setLengthUnit",
        "title": "Length Unit...",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.setFieldUnit",
        "title": "Field Unit...",
        "category": "Magpylib Studio"
      },
      {
        "command": "magpylib-studio.selectOperation",
        "title": "Show This Step"
      },
      {
        "command": "magpylib-studio.operationEarlier",
        "title": "Move Step Earlier",
        "icon": "$(arrow-up)"
      },
      {
        "command": "magpylib-studio.operationLater",
        "title": "Move Step Later",
        "icon": "$(arrow-down)"
      },
      {
        "command": "magpylib-studio.removeOperation",
        "title": "Remove Step"
      },
      {
        "command": "magpylib-studio.rollbackTo",
        "title": "Build Up To Here"
      },
      {
        "command": "magpylib-studio.rollbackClear",
        "title": "Show The Whole Scene",
        "icon": "$(history)"
      },
      {
        "command": "magpylib-studio.editOperation",
        "title": "Edit Step...",
        "icon": "$(edit)"
      }
    ],
    "keybindings": [
      {
        "command": "magpylib-studio.saveScene",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "focusedView == magpylib-studio.sceneView"
      },
      {
        "command": "magpylib-studio.saveSceneAs",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "focusedView == magpylib-studio.sceneView"
      },
      {
        "command": "magpylib-studio.copyObject",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == magpylib-studio.sceneView"
      },
      {
        "command": "magpylib-studio.cutObject",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "focusedView == magpylib-studio.sceneView"
      },
      {
        "command": "magpylib-studio.pasteObject",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "focusedView == magpylib-studio.sceneView"
      },
      {
        "command": "magpylib-studio.renameObject",
        "key": "f2",
        "mac": "enter",
        "when": "focusedView == magpylib-studio.sceneView"
      },
      {
        "command": "magpylib-studio.removeObject",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == magpylib-studio.sceneView"
      },
      {
        "command": "magpylib-studio.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "(activeCustomEditorId == 'magpylibStudio.scene' || activeWebviewPanelId == 'magpylibField') && !inputFocus && !magpylib-studio.textFocus"
      },
      {
        "command": "magpylib-studio.redo",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "(activeCustomEditorId == 'magpylibStudio.scene' || activeWebviewPanelId == 'magpylibField') && !inputFocus && !magpylib-studio.textFocus"
      },
      {
        "command": "magpylib-studio.undoTyping",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "magpylib-studio.textFocus && !inputFocus && !editorTextFocus"
      },
      {
        "command": "magpylib-studio.redoTyping",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "magpylib-studio.textFocus && !inputFocus && !editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "magpylib-studio",
          "title": "Magpylib Studio",
          "icon": "media/magnet.svg"
        }
      ]
    },
    "views": {
      "magpylib-studio": [
        {
          "id": "magpylib-studio.openScenesView",
          "name": "Open Scenes",
          "when": "magpylib-studio.scenesOpen",
          "visibility": "hidden"
        },
        {
          "id": "magpylib-studio.sceneView",
          "name": "Objects",
          "contextualTitle": "magpylib Scene"
        },
        {
          "id": "magpylib-studio.inspectorView",
          "name": "Inspector",
          "type": "webview",
          "contextualTitle": "magpylib Inspector"
        },
        {
          "id": "magpylib-studio.variablesView",
          "name": "Variables",
          "contextualTitle": "magpylib Scene Variables",
          "type": "webview"
        },
        {
          "id": "magpylib-studio.historyView",
          "name": "Undo",
          "contextualTitle": "magpylib Undo Steps",
          "visibility": "collapsed"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "*.magpy.json",
        "url": "./schemas/magpy-scene.schema.json"
      }
    ],
    "viewsWelcome": [
      {
        "view": "magpylib-studio.sceneView",
        "when": "config.magpylib-studio.drawScriptsHere == false",
        "contents": "Scripts you run in this window draw with their own backend. The studio can take them instead, so a plain `magpy.show()` opens a panel here.\n[Draw Scripts in a Panel](command:magpylib-studio.toggleDrawScriptsHere)"
      },
      {
        "view": "magpylib-studio.sceneView",
        "when": "!magpylib-studio.scenesOpen",
        "contents": "No scene is open.\n[New Scene](command:magpylib-studio.newScene)\nAn empty scene, in a tab of its own.\n[Open Scene...](command:magpylib-studio.loadScene)\nA .magpy.json scene saved earlier.\n[Load Example Scene...](command:magpylib-studio.loadExample)\nA finished scene to drag, measure and take apart.\n[Import Python Script...](command:magpylib-studio.importScript)\nRun an existing magpylib script and edit its scene here.\n[Import Mesh...](command:magpylib-studio.importMesh)\nA magnet shaped like a CAD part, from an STL, OBJ or PLY, in a new scene."
      }
    ],
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Get Started with Magpylib Studio",
        "description": "Build a magnet scene and see its field, in a few clicks.",
        "icon": "media/icon.png",
        "steps": [
          {
            "id": "loadExample",
            "title": "Pick an example",
            "description": "The gallery shows every built-in scene with a picture. Start with the Halbach rings. The first time, the studio offers to **Install the Engine**, its Python side: accept, and it sets one up.\n[Open the Example Gallery](command:magpylib-studio.loadExample)",
            "media": {
              "image": {
                "light": "media/gallery/rings-light.webp",
                "dark": "media/gallery/rings-dark.webp",
                "hc": "media/gallery/rings-dark.webp",
                "hcLight": "media/gallery/rings-light.webp"
              },
              "altText": "The Halbach rings example: two rings of magnets, and the field lines across the bore"
            },
            "completionEvents": [
              "onCommand:magpylib-studio.loadExample"
            ]
          },
          {
            "id": "variables",
            "title": "Drag a variable",
            "description": "Every example is parametric: its numbers are variables, each with a slider in the **Variables** view. Drag one and the scene rebuilds.",
            "media": {
              "markdown": "walkthroughs/variables.md"
            },
            "completionEvents": [
              "onView:magpylib-studio.variablesView"
            ]
          },
          {
            "id": "addObject",
            "title": "Edit in 3D",
            "description": "Click an object in the 3D view and drag its handles. The **Objects** view lists the steps that built it, each one editable after the fact.\n[Add Object…](command:magpylib-studio.addObject)",
            "media": {
              "markdown": "walkthroughs/add-object.md"
            },
            "completionEvents": [
              "onCommand:magpylib-studio.addObject",
              "onCommand:magpylib-studio.editOperation"
            ]
          },
          {
            "id": "fieldView",
            "title": "See the field",
            "description": "Plot the field along a sensor's path, as a map over a plane, or swept against a variable.\n[Open Field View](command:magpylib-studio.openFieldView)",
            "media": {
              "markdown": "walkthroughs/field-view.md"
            },
            "completionEvents": [
              "onCommand:magpylib-studio.openFieldView",
              "onCommand:magpylib-studio.sweep"
            ]
          },
          {
            "id": "script",
            "title": "Switch to code and back",
            "description": "The scene is a magpylib function whose parameters are the variables. Edit it as code, save, and the scene follows.\n[Edit Python Script](command:magpylib-studio.viewScript)",
            "media": {
              "markdown": "walkthroughs/script.md"
            },
            "completionEvents": [
              "onCommand:magpylib-studio.viewScript",
              "onCommand:magpylib-studio.exportScript"
            ]
          },
          {
            "id": "saveScene",
            "title": "Save your scene",
            "description": "A scene is a `.magpy.json` file in a tab of its own, saved like any other file.\n[Save Scene As…](command:magpylib-studio.saveSceneAs)",
            "media": {
              "markdown": "walkthroughs/save-scene.md"
            },
            "completionEvents": [
              "onCommand:magpylib-studio.saveSceneAs",
              "onCommand:magpylib-studio.saveScene"
            ]
          }
        ]
      }
    ],
    "submenus": [
      {
        "id": "magpylib-studio.transformSubmenu",
        "label": "Transform"
      }
    ],
    "menus": {
      "magpylib-studio.transformSubmenu": [
        {
          "command": "magpylib-studio.setPosition",
          "group": "1_pose@1"
        },
        {
          "command": "magpylib-studio.moveBy",
          "group": "1_pose@2"
        },
        {
          "command": "magpylib-studio.rotateBy",
          "group": "1_pose@3"
        },
        {
          "command": "magpylib-studio.clearPath",
          "group": "2_path@1"
        },
        {
          "command": "magpylib-studio.pixelGrid",
          "group": "2_path@2"
        },
        {
          "command": "magpylib-studio.duplicateAround",
          "when": "viewItem =~ /^magpy/",
          "group": "navigation@6"
        }
      ],
      "view/title": [
        {
          "command": "magpylib-studio.undo",
          "when": "view == magpylib-studio.historyView",
          "group": "navigation@1"
        },
        {
          "command": "magpylib-studio.redo",
          "when": "view == magpylib-studio.historyView",
          "group": "navigation@2"
        },
        {
          "command": "magpylib-studio.addVariable",
          "when": "view == magpylib-studio.variablesView",
          "group": "navigation@1"
        },
        {
          "command": "magpylib-studio.sweep",
          "when": "view == magpylib-studio.variablesView",
          "group": "navigation@2"
        },
        {
          "command": "magpylib-studio.setUnits",
          "when": "view == magpylib-studio.variablesView",
          "group": "navigation@3"
        },
        {
          "command": "magpylib-studio.saveVariant",
          "when": "view == magpylib-studio.variablesView",
          "group": "1_variants@1"
        },
        {
          "command": "magpylib-studio.saveOverVariant",
          "when": "view == magpylib-studio.variablesView",
          "group": "1_variants@2"
        },
        {
          "command": "magpylib-studio.renameVariant",
          "when": "view == magpylib-studio.variablesView",
          "group": "1_variants@3"
        },
        {
          "command": "magpylib-studio.removeVariant",
          "when": "view == magpylib-studio.variablesView",
          "group": "1_variants@4"
        },
        {
          "command": "magpylib-studio.newScene",
          "when": "view == magpylib-studio.openScenesView",
          "group": "navigation@0"
        },
        {
          "command": "magpylib-studio.loadScene",
          "when": "view == magpylib-studio.openScenesView",
          "group": "navigation@1"
        },
        {
          "command": "magpylib-studio.closeAllScenes",
          "when": "view == magpylib-studio.openScenesView && magpylib-studio.scenesOpen",
          "group": "navigation@2"
        },
        {
          "command": "magpylib-studio.loadExample",
          "when": "view == magpylib-studio.openScenesView",
          "group": "1_open@1"
        },
        {
          "command": "magpylib-studio.importScript",
          "when": "view == magpylib-studio.openScenesView",
          "group": "1_open@2"
        },
        {
          "command": "magpylib-studio.addObject",
          "when": "view == magpylib-studio.sceneView && magpylib-studio.scenesOpen",
          "group": "navigation@0"
        },
        {
          "command": "magpylib-studio.viewScript",
          "when": "view == magpylib-studio.sceneView && magpylib-studio.scenesOpen",
          "group": "navigation@1"
        },
        {
          "command": "magpylib-studio.openFieldView",
          "when": "view == magpylib-studio.sceneView && magpylib-studio.scenesOpen",
          "group": "navigation@2"
        },
        {
