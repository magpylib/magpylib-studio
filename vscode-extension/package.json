      "properties": {
        "magpylib-studio.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python interpreter used to run the magpylib-studio engine. Empty = auto-detect (.venv next to the workspace, then python3)."
        },
        "magpylib-studio.scriptTimeout": {
          "type": "number",
          "default": 300,
          "minimum": 1,
          "description": "How long a script may run, in seconds, when Open in Magpylib Studio or the script tab's save runs it, before it is stopped. It runs in a process of its own, so stopping it leaves every scene as it was."
        },
        "magpylib-studio.drawScriptsHere": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Make `studio` the default plotting backend for magpylib scripts run from a terminal in this window, so a plain `magpy.show()` draws in a panel instead of opening a Matplotlib window.\n\nApplies to **every** script run from those terminals — test runs excepted — and takes effect in terminals opened after it is changed. Scripts that set their own backend are left alone."
