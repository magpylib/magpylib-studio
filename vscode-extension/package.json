{
  "name": "magpylib-studio-vscode",
  "displayName": "Magpylib Studio",
  "description": "VS Code extension shell for the magpylib-studio headless engine.",
  "version": "0.4.1",
  "publisher": "magpylib",
  "license": "BSD-3-Clause",
  "icon": "media/icon.png",
  "preview": true,
  "keywords": [
    "magpylib",
    "magnetics",
    "magnetic field",
    "simulation",
    "physics"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/magpylib/magpylib-studio.git"
  },
  "bugs": {
    "url": "https://github.com/magpylib/magpylib-studio/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The engine runs as a Python interpreter found in the workspace, and the script tab executes the scene as Python."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "The engine is a local process that reads and writes real files."
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "magpylib-studio.toggleDrawScriptsHere",
        "title": "Magpylib Studio: Draw Scripts in a Panel"
      },
      {
        "command": "magpylib-studio.openStudio",
        "title": "Magpylib Studio: Open Scene View",
        "icon": "$(open-preview)"
      },
      {
        "command": "magpylib-studio.refreshScene",
        "title": "Magpylib Studio: Refresh Scene",
        "icon": "$(refresh)"
      },
      {
        "command": "magpylib-studio.selectObject",
        "title": "Magpylib Studio: Select Object in Studio"
      },
      {
        "command": "magpylib-studio.loadExample",
        "title": "Magpylib Studio: Load Example Scene..."
      },
      {
        "command": "magpylib-studio.openFieldView",
        "title": "Magpylib Studio: Open Field View",
        "icon": "$(graph-line)"
      },
      {
        "command": "magpylib-studio.viewScript",
        "title": "Magpylib Studio: Edit Python Script",
        "icon": "$(code)"
      },
      {
        "command": "magpylib-studio.saveScene",
        "title": "Magpylib Studio: Save Scene",
        "icon": "$(save)"
      },
      {
        "command": "magpylib-studio.saveSceneAs",
        "title": "Magpylib Studio: Save Scene As..."
      },
      {
        "command": "magpylib-studio.loadScene",
        "title": "Magpylib Studio: Open Scene..."
      },
      {
        "command": "magpylib-studio.newScene",
        "title": "Magpylib Studio: New Scene"
      },
      {
        "command": "magpylib-studio.closeScene",
        "title": "Magpylib Studio: Close Scene",
        "icon": "$(close)"
      },
      {
        "command": "magpylib-studio.revertScene",
        "title": "Magpylib Studio: Revert Scene to Saved"
      },
      {
        "command": "magpylib-studio.exportScript",
        "title": "Magpylib Studio: Export as Python Script..."
      },
      {
        "command": "magpylib-studio.exportBuilderScript",
        "title": "Magpylib Studio: Export as Scene Script..."
      },
      {
        "command": "magpylib-studio.importScript",
        "title": "Magpylib Studio: Import Python Script..."
      },
      {
        "command": "magpylib-studio.openScriptInStudio",
        "title": "Open in Magpylib Studio"
      },
      {
        "command": "magpylib-studio.switchScene",
        "title": "Magpylib Studio: Switch Imported Scene..."
      },
      {
        "command": "magpylib-studio.undo",
        "title": "Magpylib Studio: Undo Scene Edit",
        "icon": "$(discard)"
      },
      {
        "command": "magpylib-studio.redo",
        "title": "Magpylib Studio: Redo Scene Edit",
        "icon": "$(redo)"
      },
      {
        "command": "magpylib-studio.removeObject",
        "title": "Remove Object"
      },
      {
        "command": "magpylib-studio.resetStyle",
        "title": "Reset Style"
      },
      {
        "command": "magpylib-studio.moveTo",
        "title": "Move to..."
      },
      {
        "command": "magpylib-studio.gotoHistory",
        "title": "Magpylib Studio: Jump to Undo Step"
      },
      {
        "command": "magpylib-studio.newCollection",
        "title": "New Collection...",
        "icon": "$(new-folder)"
      },
      {
        "command": "magpylib-studio.addObject",
        "title": "Magpylib Studio: Add Object...",
        "icon": "$(add)"
      },
      {
        "command": "magpylib-studio.addMesh",
        "title": "Magpylib Studio: Add Triangular Mesh..."
      },
      {
        "command": "magpylib-studio.importMesh",
        "title": "Magpylib Studio: Import Mesh..."
      },
      {
        "command": "magpylib-studio.meshFromPoints",
        "title": "Magpylib Studio: Mesh from Points..."
      },
      {
        "command": "magpylib-studio.meshFromFormula",
        "title": "Magpylib Studio: Mesh from a Formula..."
      },
      {
        "command": "magpylib-studio.setPosition",
        "title": "Set Position..."
      },
      {
        "command": "magpylib-studio.moveBy",
        "title": "Move By...",
        "icon": "$(move)"
      },
      {
        "command": "magpylib-studio.rotateBy",
        "title": "Rotate...",
        "icon": "$(sync)"
      },
      {
        "command": "magpylib-studio.clearPath",
        "title": "Clear Path"
      },
      {
        "command": "magpylib-studio.pixelGrid",
        "title": "Pixel Grid..."
      },
      {
        "command": "magpylib-studio.toggleVisibility",
        "title": "Toggle Visibility",
        "icon": "$(eye)"
      },
      {
        "command": "magpylib-studio.copyObject",
        "title": "Copy"
      },
      {
        "command": "magpylib-studio.cutObject",
        "title": "Cut"
      },
      {
        "command": "magpylib-studio.pasteObject",
        "title": "Paste"
      },
      {
        "command": "magpylib-studio.renameObject",
        "title": "Rename..."
      },
      {
        "command": "magpylib-studio.addVariable",
        "title": "New Variable...",
        "icon": "$(add)"
      },
      {
        "command": "magpylib-studio.editVariable",
        "title": "Edit Variable..."
      },
      {
        "command": "magpylib-studio.renameVariable",
        "title": "Rename Variable..."
      },
      {
        "command": "magpylib-studio.removeVariable",
        "title": "Remove Variable",
        "icon": "$(trash)"
      },
      {
        "command": "magpylib-studio.duplicateAround",
        "title": "Pattern..."
      },
      {
        "command": "magpylib-studio.sweep",
        "title": "Magpylib Studio: Sweep a Variable...",
        "icon": "$(graph-line)"
      },
      {
        "command": "magpylib-studio.setVariableBounds",
        "title": "Variable Properties..."
      },
      {
        "command": "magpylib-studio.setUnits",
        "title": "Magpylib Studio: Units...",
        "icon": "$(symbol-ruler)"
      },
      {
        "command": "magpylib-studio.setLengthUnit",
        "title": "Magpylib Studio: Length Unit..."
      },
      {
        "command": "magpylib-studio.setFieldUnit",
        "title": "Magpylib Studio: Field Unit..."
      },
      {
        "command": "magpylib-studio.selectOperation",
        "title": "Show This Step"
      },
      {
        "command": "magpylib-studio.operationEarlier",
        "title": "Move Step Earlier",
        "icon": "$(arrow-up)"
      },
      {
        "command": "magpylib-studio.operationLater",
        "title": "Move Step Later",
        "icon": "$(arrow-down)"
      },
      {
        "command": "magpylib-studio.removeOperation",
        "title": "Remove Step"
      },
      {
        "command": "magpylib-studio.rollbackTo",
        "title": "Build Up To Here"
      },
      {
        "command": "magpylib-studio.rollbackClear",
        "title": "Show The Whole Scene",
        "icon": "$(history)"
      },
      {
        "command": "magpylib-studio.editOperation",
        "title": "Edit Step...",
        "icon": "$(edit)"
      }
    ],
    "keybindings": [
      {
        "command": "magpylib-studio.saveScene",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "focusedView == magpylib-studio.sceneView"
      },
      {
        "command": "magpylib-studio.saveSceneAs",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "focusedView == magpylib-studio.sceneView"
      },
      {
        "command": "magpylib-studio.copyObject",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == magpylib-studio.sceneView"
      },
      {
        "command": "magpylib-studio.cutObject",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "focusedView == magpylib-studio.sceneView"
      },
      {
        "command": "magpylib-studio.pasteObject",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "focusedView == magpylib-studio.sceneView"
      },
      {
        "command": "magpylib-studio.renameObject",
        "key": "f2",
        "mac": "enter",
        "when": "focusedView == magpylib-studio.sceneView"
      },
      {
        "command": "magpylib-studio.removeObject",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == magpylib-studio.sceneView"
      },
      {
        "command": "magpylib-studio.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeWebviewPanelId == 'magpylibStudio' || activeWebviewPanelId == 'magpylibField'"
      },
      {
        "command": "magpylib-studio.redo",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "activeWebviewPanelId == 'magpylibStudio' || activeWebviewPanelId == 'magpylibField'"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "magpylib-studio",
          "title": "Magpylib Studio",
          "icon": "media/magnet.svg"
        }
      ]
    },
    "views": {
      "magpylib-studio": [
        {
          "id": "magpylib-studio.sceneView",
          "name": "Scene",
          "contextualTitle": "magpylib Scene"
        },
        {
          "id": "magpylib-studio.inspectorView",
          "name": "Inspector",
          "type": "webview",
          "contextualTitle": "magpylib Inspector"
        },
        {
          "id": "magpylib-studio.variablesView",
          "name": "Variables",
          "contextualTitle": "magpylib Scene Variables",
          "type": "webview"
        },
        {
          "id": "magpylib-studio.historyView",
          "name": "Undo",
          "contextualTitle": "magpylib Undo Steps",
          "visibility": "collapsed"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "*.magpy.json",
        "url": "./schemas/magpy-scene.schema.json"
      }
    ],
    "viewsWelcome": [
      {
        "view": "magpylib-studio.sceneView",
        "when": "config.magpylib-studio.drawScriptsHere == false",
        "contents": "Scripts you run in this window draw with their own backend. The studio can take them instead, so a plain `magpy.show()` opens a panel here.\n[Draw Scripts in a Panel](command:magpylib-studio.toggleDrawScriptsHere)"
      },
      {
        "view": "magpylib-studio.sceneView",
        "contents": "The scene is empty.\n[Add Object...](command:magpylib-studio.addObject)\nA magnet, current, sensor or collection.\n[Load Example Scene...](command:magpylib-studio.loadExample)\nA finished scene to drag, measure and take apart.\n[Open Scene...](command:magpylib-studio.loadScene)\nA .magpy.json scene saved earlier.\n[Import Mesh...](command:magpylib-studio.importMesh)\nA magnet shaped like a CAD part, from an STL, OBJ or PLY.\n[Import Python Script...](command:magpylib-studio.importScript)\nRun an existing magpylib script and edit its scene here."
      }
    ],
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Get Started with Magpylib Studio",
        "description": "Build a magnet scene and see its field, in a few clicks.",
        "icon": "media/icon.png",
        "steps": [
          {
            "id": "openStudio",
            "title": "Open the Studio view",
            "description": "The Studio panel renders the scene with magpylib's own 3D plot, and stays open as you edit.\n[Open Scene View](command:magpylib-studio.openStudio)",
            "media": {
              "markdown": "walkthroughs/open-studio.md"
            },
            "completionEvents": [
              "onCommand:magpylib-studio.openStudio"
            ]
          },
          {
            "id": "loadExample",
            "title": "Load an example",
            "description": "Ready-made scenes, each a handful of parametric steps — load one and drag its sliders.\n[Load Example Scene…](command:magpylib-studio.loadExample)",
            "media": {
              "markdown": "walkthroughs/load-example.md"
            },
            "completionEvents": [
              "onCommand:magpylib-studio.loadExample"
            ]
          },
          {
            "id": "addObject",
            "title": "Add your own object",
            "description": "Add a magnet, current source, sensor or collection, then click it in the Scene tree to edit it in the Inspector.\n[Add Object…](command:magpylib-studio.addObject)",
            "media": {
              "markdown": "walkthroughs/add-object.md"
            },
            "completionEvents": [
              "onCommand:magpylib-studio.addObject"
            ]
          },
          {
            "id": "fieldView",
            "title": "See the field",
            "description": "Plot B, H, J or M along a sensor's path — magpylib's own field rendering, in its own panel.\n[Open Field View](command:magpylib-studio.openFieldView)",
            "media": {
              "markdown": "walkthroughs/field-view.md"
            },
            "completionEvents": [
              "onCommand:magpylib-studio.openFieldView"
            ]
          },
          {
            "id": "saveScene",
            "title": "Save your work",
            "description": "Scenes save as `.magpy.json`, reopenable later, or export a runnable Python script.\n[Save Scene As…](command:magpylib-studio.saveSceneAs)",
            "media": {
              "markdown": "walkthroughs/save-scene.md"
            },
            "completionEvents": [
              "onCommand:magpylib-studio.saveSceneAs"
            ]
          }
        ]
      }
    ],
    "submenus": [
      {
        "id": "magpylib-studio.transformSubmenu",
        "label": "Transform"
      }
    ],
    "menus": {
      "magpylib-studio.transformSubmenu": [
        {
          "command": "magpylib-studio.setPosition",
          "group": "1_pose@1"
        },
        {
          "command": "magpylib-studio.moveBy",
          "group": "1_pose@2"
        },
        {
          "command": "magpylib-studio.rotateBy",
          "group": "1_pose@3"
        },
        {
          "command": "magpylib-studio.clearPath",
          "group": "2_path@1"
        },
        {
          "command": "magpylib-studio.pixelGrid",
          "group": "2_path@2"
        },
        {
          "command": "magpylib-studio.duplicateAround",
          "when": "viewItem =~ /^magpy/",
          "group": "navigation@6"
        }
      ],
      "view/title": [
        {
          "command": "magpylib-studio.undo",
          "when": "view == magpylib-studio.sceneView",
          "group": "navigation@1"
        },
        {
          "command": "magpylib-studio.redo",
          "when": "view == magpylib-studio.sceneView",
          "group": "navigation@2"
        },
        {
          "command": "magpylib-studio.undo",
          "when": "view == magpylib-studio.historyView",
          "group": "navigation@1"
        },
        {
          "command": "magpylib-studio.redo",
          "when": "view == magpylib-studio.historyView",
          "group": "navigation@2"
        },
        {
          "command": "magpylib-studio.addObject",
          "when": "view == magpylib-studio.sceneView",
          "group": "navigation@0"
        },
        {
          "command": "magpylib-studio.refreshScene",
          "when": "view == magpylib-studio.sceneView",
          "group": "navigation@3"
        },
        {
          "command": "magpylib-studio.openStudio",
          "when": "view == magpylib-studio.sceneView",
          "group": "navigation@4"
        },
        {
          "command": "magpylib-studio.openFieldView",
          "when": "view == magpylib-studio.sceneView",
          "group": "navigation@5"
        },
        {
          "command": "magpylib-studio.viewScript",
          "when": "view == magpylib-studio.sceneView",
          "group": "navigation@6"
        },
        {
          "command": "magpylib-studio.newScene",
          "when": "view == magpylib-studio.sceneView",
          "group": "1_file@1"
        },
        {
          "command": "magpylib-studio.closeScene",
          "when": "view == magpylib-studio.sceneView",
          "group": "navigation@8"
        },
        {
          "command": "magpylib-studio.loadScene",
          "when": "view == magpylib-studio.sceneView",
          "group": "1_file@2"
        },
        {
          "command": "magpylib-studio.saveScene",
          "when": "view == magpylib-studio.sceneView && magpylib-studio.sceneDirty",
          "group": "navigation@7"
        },
        {
          "command": "magpylib-studio.saveSceneAs",
          "when": "view == magpylib-studio.sceneView",
          "group": "1_file@4"
        },
        {
          "command": "magpylib-studio.revertScene",
          "when": "view == magpylib-studio.sceneView && magpylib-studio.sceneFile",
          "group": "1_file@5"
        },
        {
          "command": "magpylib-studio.loadExample",
          "when": "view == magpylib-studio.sceneView",
          "group": "2_scene@1"
        },
        {
          "command": "magpylib-studio.importScript",
          "when": "view == magpylib-studio.sceneView",
          "group": "2_scene@2"
        },
        {
          "command": "magpylib-studio.exportScript",
          "when": "view == magpylib-studio.sceneView",
          "group": "2_scene@3"
        },
        {
          "command": "magpylib-studio.exportBuilderScript",
          "when": "view == magpylib-studio.sceneView",
          "group": "2_scene@4"
        },
        {
          "command": "magpylib-studio.newCollection",
          "when": "view == magpylib-studio.sceneView",
          "group": "2_scene@5"
        },
        {
          "command": "magpylib-studio.addVariable",
          "when": "view == magpylib-studio.variablesView",
          "group": "navigation@1"
        },
        {
          "command": "magpylib-studio.sweep",
          "when": "view == magpylib-studio.variablesView",
          "group": "navigation@2"
        },
        {
          "command": "magpylib-studio.setUnits",
          "when": "view == magpylib-studio.variablesView",
          "group": "navigation@3"
        },
        {
          "command": "magpylib-studio.rollbackClear",
          "when": "view == magpylib-studio.sceneView && magpylib-studio.rolledBack",
          "group": "navigation@0"
        }
      ],
      "explorer/context": [
        {
          "command": "magpylib-studio.openScriptInStudio",
          "when": "resourceExtname == .py",
          "group": "navigation"
        },
        {
          "command": "magpylib-studio.loadScene",
          "when": "resourceFilename =~ /\\.magpy\\.json$/",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "magpylib-studio.openScriptInStudio",
          "when": "resourceExtname == .py"
        },
        {
          "command": "magpylib-studio.loadScene",
          "when": "resourceFilename =~ /\\.magpy\\.json$/"
        }
      ],
      "view/item/context": [
        {
          "command": "magpylib-studio.toggleVisibility",
          "when": "view == magpylib-studio.sceneView && viewItem =~ /^magpy/",
          "group": "inline@0"
        },
        {
          "command": "magpylib-studio.moveBy",
          "when": "view == magpylib-studio.sceneView && viewItem =~ /^magpy/",
          "group": "inline@1"
        },
        {
          "command": "magpylib-studio.rotateBy",
          "when": "view == magpylib-studio.sceneView && viewItem =~ /^magpy/",
          "group": "inline@2"
        },
        {
          "command": "magpylib-studio.renameObject",
          "when": "view == magpylib-studio.sceneView && viewItem =~ /^magpy/",
          "group": "0_edit@1"
        },
        {
          "command": "magpylib-studio.copyObject",
          "when": "view == magpylib-studio.sceneView && viewItem =~ /^magpy/",
          "group": "0_edit@2"
        },
        {
          "command": "magpylib-studio.cutObject",
          "when": "view == magpylib-studio.sceneView && viewItem =~ /^magpy/",
          "group": "0_edit@3"
        },
        {
          "command": "magpylib-studio.pasteObject",
          "when": "view == magpylib-studio.sceneView && viewItem =~ /^magpy/",
          "group": "0_edit@4"
        },
        {
          "submenu": "magpylib-studio.transformSubmenu",
          "when": "view == magpylib-studio.sceneView && viewItem =~ /^magpy/",
          "group": "1_move@0"
        },
        {
          "command": "magpylib-studio.addObject",
          "when": "view == magpylib-studio.sceneView && viewItem =~ /^magpyCollection/",
          "group": "1_move@3"
        },
        {
          "command": "magpylib-studio.importMesh",
          "when": "view == magpylib-studio.sceneView && viewItem =~ /^magpyCollection/",
          "group": "1_move@4"
        },
        {
          "command": "magpylib-studio.moveTo",
          "when": "view == magpylib-studio.sceneView && viewItem =~ /^magpy/",
          "group": "1_move@1"
        },
        {
          "command": "magpylib-studio.newCollection",
          "when": "view == magpylib-studio.sceneView && viewItem =~ /^magpyCollection/",
          "group": "1_move@2"
        },
        {
          "command": "magpylib-studio.removeObject",
          "when": "view == magpylib-studio.sceneView && viewItem =~ /^magpy/",
          "group": "2_modify@1"
        },
        {
          "command": "magpylib-studio.resetStyle",
          "when": "view == magpylib-studio.sceneView && viewItem =~ /^magpy/",
          "group": "2_modify@2"
        },
        {
          "command": "magpylib-studio.operationEarlier",
          "when": "view == magpylib-studio.sceneView && viewItem =~ /^magpyOperation/",
          "group": "inline@1"
        },
        {
          "command": "magpylib-studio.operationLater",
          "when": "view == magpylib-studio.sceneView && viewItem =~ /^magpyOperation/",
          "group": "inline@2"
        },
        {
          "command": "magpylib-studio.rollbackTo",
          "when": "view == magpylib-studio.sceneView && viewItem =~ /^magpyOperation/",
          "group": "0_step@1"
        },
        {
          "command": "magpylib-studio.removeOperation",
          "when": "view == magpylib-studio.sceneView && viewItem =~ /^magpyOperation/",
          "group": "0_step@2"
        },
        {
          "command": "magpylib-studio.removeObject",
          "when": "view == magpylib-studio.sceneView && viewItem == magpyOperationCreate",
          "group": "0_step@3"
        },
        {
          "command": "magpylib-studio.editOperation",
          "when": "view == magpylib-studio.sceneView && viewItem =~ /^magpyOperation/",
          "group": "inline@0"
        },
        {
          "command": "magpylib-studio.editOperation",
          "when": "view == magpylib-studio.sceneView && viewItem =~ /^magpyOperation/",
          "group": "0_step@0"
        }
      ],
      "commandPalette": [
        {
          "command": "magpylib-studio.addMesh",
          "when": "false"
        },
        {
